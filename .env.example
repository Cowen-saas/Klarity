# Copy to .env.local for host-side tooling (Next.js dev server, Prisma CLI) and/or
# to .env for `docker compose` variable interpolation. Never commit either file —
# see .gitignore. Values below use `localhost`; the app/worker Compose services
# override DATABASE_URL/REDIS_URL to the in-network hostnames (postgres/redis)
# directly in docker-compose.yml, so this file does not need two variants.

# --- PostgreSQL (§3, §3.1) ---
POSTGRES_USER=klarity
POSTGRES_PASSWORD=klarity
POSTGRES_DB=klarity
DATABASE_URL=postgresql://klarity:klarity@localhost:5432/klarity?schema=public

# --- Redis / BullMQ (§3, §3.1, §8) ---
REDIS_URL=redis://localhost:6379

# --- Auth.js v5 (§2.7, §7) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Access token lifetime (short) and refresh rotation window (long) — §2.7, §7.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- AI provider — Claude API, access en attente (§6) ---
# mock | live — see src/lib/ai/index.ts
AI_MODE=mock
ANTHROPIC_API_KEY=

# --- Payment provider — NotchPay (Mobile Money) — see src/lib/payment/index.ts ---
# mock | notchpay.
PAYMENT_MODE=mock
# sandbox | live — which NotchPay key pair below the provider actually uses.
# Independent from PAYMENT_MODE: PAYMENT_MODE=notchpay + NOTCHPAY_ENV=sandbox
# hits the real NotchPay API in test mode, no real money moved. Defaults to
# sandbox so this can never silently go live from a missing/blank value.
NOTCHPAY_ENV=sandbox

# Sandbox keys (NotchPay dashboard, Test mode) — used when NOTCHPAY_ENV=sandbox.
# Public key: Settings > API Keys — sent as the Authorization header for payment
# initiation, per NotchPay's docs.
NOTCHPAY_PUBLIC_KEY=
# Webhook "Hash Key" (Settings > API Keys, not the same value as the public/secret
# API keys) — verifies the x-notch-signature header (HMAC-SHA256) on webhooks.
NOTCHPAY_WEBHOOK_SECRET=

# Live keys (NotchPay dashboard, Live mode) — used when NOTCHPAY_ENV=live. Keep
# these set even while NOTCHPAY_ENV=sandbox — they're only read once switched.
NOTCHPAY_PUBLIC_KEY_LIVE=
# Not read by any code yet (the current 2-call payment flow only needs the
# public + webhook keys, in both sandbox and live) — stored here so it's not
# lost if a future NotchPay flow needs it.
NOTCHPAY_PRIVATE_KEY_LIVE=
NOTCHPAY_WEBHOOK_SECRET_LIVE=

# --- Cloudflare R2 (§3, §4.2, §4.3) ---
# STORAGE_MODE : mock | r2 — see src/lib/storage/index.ts.
#   mock : fichiers dans .storage-mock/ (gitignoré), aucune dépendance externe.
#   r2   : Cloudflare R2 réel (R2StorageProvider) — renseigner les 4 R2_* ci-dessous.
STORAGE_MODE=mock
# Secret HMAC des URLs signées du MockStorageProvider (optionnel, défaut dev).
STORAGE_MOCK_SIGNING_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Notifications — SMS OTP + WhatsApp Business API, sortant uniquement (§1.2, §2.2.3, §3) ---
# SMS_MODE : mock | smspro — see src/lib/sms/index.ts. Garder mock tant que le
# passage en production n'est pas explicitement confirmé.
SMS_MODE=mock
# Compte SmsPro (fournisseur SMS, remplace Africa's Talking — cf. docs/PROGRESS.md).
# Clé générée depuis Hub Développeur > Clés API sur v2.smspro.cm.
SMSPRO_API_KEY=
# Sender ID déjà déclaré sur le compte SmsPro (ex. "Klarity") pour les SMS non-OTP
# (rappel de renouvellement, résumé de progression, alerte d'inactivité).
SMSPRO_SENDER_ID=
# Optionnel : Sender ID distinct déclaré en usage "OTP" (recommandé par SmsPro pour
# un acheminement fiable du code de connexion parent — distinct d'un Sender ID
# "Marketing"). Repli sur SMSPRO_SENDER_ID si laissé vide.
SMSPRO_SENDER_ID_OTP=
WHATSAPP_BUSINESS_API_TOKEN=

# --- Rétention des comptes élève (§2.9) — jobs worker. Valeurs de départ, non
# figées ; réduire pour tester le déclenchement des jobs. Voir src/lib/retention/config.ts.
RETENTION_INACTIVITE_JOURS=180
RETENTION_GRACE_JOURS=60
RETENTION_ARCHIVAGE_RECUL_ANS=1

# --- YouTube Data API v3 (§2.5, §3) ---
YOUTUBE_API_KEY=

NODE_ENV=development
